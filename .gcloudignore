# Upload filter for `gcloud run deploy --source .` (Cloud Run image build).
.git
.gitignore
.gitattributes
data/
userdata/
docs/
updater/
tests/
*.md
*.png
__pycache__/
**/__pycache__/
.pytest_cache/
.playwright-mcp/
firebase.json
.firebaserc
# secrets / credentials — never ship
.env
.env.*
*.key
*.pem
*-key.json
*_key.json
credentials*.json
service-account*.json
gcloud-*.json
